---
const navLinks = [
  { href: '/leistungen', label: 'Leistungen' },
  { href: '/aktuelles', label: 'Aktuelles' },
  { href: '/wissen', label: 'Wissen' },
  { href: '/kontakt', label: 'Kontakt' },
];

const currentPath = Astro.url.pathname;
---

<header class="bg-zinc-900/80 backdrop-blur-md border-b border-white/5 sticky top-0 z-50">
  <div class="max-w-6xl mx-auto px-4 py-4 flex items-center justify-between">
    <a href="/" class="flex items-center gap-2 font-bold text-xl text-white hover:opacity-80 transition">
      <span class="text-teal-400">DW</span>
      <span>Dialogwerk <span class="font-light text-zinc-400">Niedersachsen</span></span>
    </a>

    <nav class="hidden md:flex items-center gap-6">
      {navLinks.map(link => (
        <a 
          href={link.href} 
          class={`text-sm font-medium transition hover:text-teal-400 ${currentPath.startsWith(link.href) ? 'text-teal-400 border-b border-teal-400 pb-0.5' : 'text-zinc-400'}`}
        >
          {link.label}
        </a>
      ))}
      <a href="/termin" class="bg-teal-500 text-zinc-950 text-sm font-bold px-4 py-2 rounded-lg hover:bg-teal-400 transition">
        Termin anfragen
      </a>
    </nav>

    <!-- Mobile menu button -->
    <button id="mobile-menu-btn" class="md:hidden p-2 text-zinc-400" aria-label="Menue oeffnen">
      <svg width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
        <line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="18" x2="21" y2="18"/>
      </svg>
    </button>
  </div>

  <!-- Mobile nav -->
  <div id="mobile-menu" class="hidden md:hidden px-4 pb-4 bg-zinc-900 border-t border-white/5">
    {navLinks.map(link => (
      <a href={link.href} class="block py-2 text-zinc-400 hover:text-teal-400 font-medium">{link.label}</a>
    ))}
    <a href="/termin" class="block mt-2 bg-teal-500 text-zinc-950 text-center font-bold px-4 py-2 rounded-lg">Termin anfragen</a>
  </div>
</header>

<script>
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  btn?.addEventListener('click', () => menu?.classList.toggle('hidden'));
</script>
